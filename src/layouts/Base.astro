---
import '@fontsource/lexend/400.css';
import '@fontsource/lexend/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { SITE, NAV } from '../config';

interface Props { title?: string; description?: string; home?: boolean }
const { title, description = SITE.description, home = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · Supply chains, sustainability, post-growth`;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const person = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': `${SITE.url}/#person`, name: SITE.name, givenName: 'Davide', familyName: 'Luzzini',
      url: SITE.url, description: SITE.description,
      jobTitle: 'Professor',
      worksFor: { '@type': 'CollegeOrUniversity', name: 'EADA Business School', url: 'https://www.eada.edu', address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' } },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Politecnico di Milano' },
      knowsAbout: ['Supply chain management', 'Sustainable supply chains', 'Post-growth', 'Purchasing and supply management', 'Operations management'],
      sameAs: [SITE.orcid, 'https://scholar.google.com/citations?user=Vc2t0NgAAAAJ', SITE.linkedin, SITE.eada],
    },
    { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.name, publisher: { '@id': `${SITE.url}/#person` }, inLanguage: 'en' },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content="#070b0a" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:image" content={`${SITE.url}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Davide Luzzini: supply chains within the limits of people and planet" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="author" content={SITE.name} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <canvas id="sky" aria-hidden="true"></canvas>
  <div class="shell">
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">Davide Luzzini</a>
        <nav class="navlinks" aria-label="Main">
          {NAV.map(n => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="cv" href={SITE.cv} target="_blank" rel="noopener">CV</a>
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <span>Davide Luzzini · EADA Business School · Barcelona</span>
        <nav aria-label="Footer">
          <a href={SITE.orcid} target="_blank" rel="noopener">ORCID</a>
          <a href={SITE.scholar} target="_blank" rel="noopener">Google Scholar</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={SITE.cv} target="_blank" rel="noopener">Full CV</a>
        </nav>
      </div>
    </footer>
  </div>
  <script>
    import { startSky } from '../scripts/sky';
    startSky();
  </script>
</body>
</html>
