---
import Base from '../layouts/Base.astro';
import Explorer from '../components/Explorer.astro';
import Topics from '../components/Topics.astro';
import { publications, pubItem } from '../lib/items';
import { SITE } from '../config';
---
<Base title="Research" description="Research on sustainable supply chains: post-growth, systemic change, social impact, supply chain complexity and purchasing. Publications with abstracts, search and filters.">
  <section class="view">
    <div class="page-head">
      <span class="mono">Research</span>
      <h1>Research</h1>
      <p class="lede">I study sustainable supply chains, mostly through complexity, social impact, systems thinking and, more recently, post-growth and the footprint perspective. I rarely work alone: most of these papers come from long collaborations with colleagues and PhD students, and from companies that opened their doors to us.</p>
    </div>
    <div class="block">
      <header><span class="mono">Topics</span></header>
      <Topics />
    </div>
    <div class="block">
      <header><span class="mono">Currently working on</span></header>
      <ul class="plain now">
        <li><span>Post-growth</span><span>Post-growth supply ecosystems in craft-based fashion</span></li>
        <li><span>Footprints</span><span>Studying supply chain impacts from the places where they happen, not only from the buying firm: what we call the footprint perspective</span></li>
        <li><span>Procurement</span><span>How AI is changing the work of procurement professionals</span></li>
      </ul>
    </div>
    <div class="block">
      <header><span class="mono">Journal articles, books and chapters</span><h2>Publications</h2></header>
      <Explorer items={publications.map(pubItem)} controls initial={8} noun="publications" placeholder="Search titles, co-authors, journals, abstracts" emptyAbstract="No abstract available yet." />
      <p class="note">Abstracts come from OpenAlex and Crossref where available. Conference papers are listed in the <a href={SITE.cv} target="_blank" rel="noopener">full CV</a>.</p>
    </div>
  </section>
</Base>
